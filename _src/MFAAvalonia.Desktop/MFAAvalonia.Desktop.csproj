<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- 优先使用目标 RID；普通构建没有 RID 时，回退到当前 .NET SDK 的宿主 RID。 -->
        <_MatrTargetRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_MatrTargetRid>
        <_MatrTargetRid Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</_MatrTargetRid>
        <_MatrIsWindows Condition="$([System.String]::Copy('$(_MatrTargetRid)').StartsWith('win'))">true</_MatrIsWindows>
        <_MatrIsWindows Condition="'$(_MatrIsWindows)' == ''">false</_MatrIsWindows>
    </PropertyGroup>

    <PropertyGroup>
        <!-- WinExe 抑制 Windows 上的控制台窗口；非 Windows 上无该子系统概念，用 Exe 更贴切 -->
        <OutputType Condition="'$(_MatrIsWindows)' == 'true'">WinExe</OutputType>
        <OutputType Condition="'$(_MatrIsWindows)' != 'true'">Exe</OutputType>
        <AssemblyName>MATR</AssemblyName>
        <OutputName>MATR</OutputName>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <!-- 实际以 RID 发布；声明 AnyCPU 以匹配默认 Platform，避免 osx/linux 构建被 x64-only 限制 -->
        <Platforms>AnyCPU;x64</Platforms>
        <!-- app.manifest 与 .ico 均为 Windows 专属，非 Windows 忽略；显式条件化保持整洁 -->
        <ApplicationManifest Condition="'$(_MatrIsWindows)' == 'true'">app.manifest</ApplicationManifest>
        <ApplicationIcon Condition="'$(_MatrIsWindows)' == 'true'">..\MFAAvalonia\Assets\logo.ico</ApplicationIcon>
        <CETCompat>false</CETCompat>
    </PropertyGroup>

    <PropertyGroup>
        <DebianPackageDependencies>dotnet-runtime-8.0;libc6;libgtk-3-0</DebianPackageDependencies>
        <RuntimeIdentifiers Condition="'$(RuntimeIdentifier)' == '' and '$(RuntimeIdentifiers)' == ''">win-x64;linux-x64;osx-x64;win-arm64;linux-arm64;osx-arm64</RuntimeIdentifiers>
        <RuntimeIdentifiers Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</RuntimeIdentifiers>
        <MaaFrameworkPlatform>$(RuntimeIdentifier)</MaaFrameworkPlatform>
        <OutputPath>../bin/$(Platform)/$(Configuration)/</OutputPath>
        <IntermediateOutputPath>obj/$(Platform)/$(Configuration)/$(TargetFramework)/</IntermediateOutputPath>
        <PublishReadyToRun>false</PublishReadyToRun>
        <PublishSingleFile>false</PublishSingleFile>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PublishTrimmed>false</PublishTrimmed>
        <SelfContained>false</SelfContained>
        <GenerateResource>Always</GenerateResource>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        <MaaAgentBinaryPath>libs/MaaAgentBinary</MaaAgentBinaryPath>
        <BeautyLibsDir>.;./runtimes/libs</BeautyLibsDir>
        <BeautyOnPublishOnly>True</BeautyOnPublishOnly>
        <!-- NetBeauty 仅为整理输出目录的可选优化，非运行必需，故全部禁用：
             - 其 BeautyLibsDir 用 ';' 分隔目录，在非 Windows 的 /bin/sh 下 ';' 会被当作命令分隔符导致失败；
             - 在 Windows 上会把托管库整理进字面目录 ".;/runtimes/libs"，破坏标准 publish 布局。
             发布产物保持标准平铺布局，由 tools/pack_win.ps1 统一整理到 runtimes/libs。
             代理路径由 MaaProcessor.ResolveAgentBinaryPath 回退查找 libs/ 或根目录。 -->
        <DisableBeauty>True</DisableBeauty>
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>

    <ItemGroup Condition="'$(_MatrIsWindows)' == 'true'">
        <PackageReference Update="Packaging.Targets">
            <Version>0.1.232</Version>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" Version="11.3.12"/>
        <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.3.12"/>
        <PackageReference Include="nulastudio.NetBeauty" Version="2.1.5" Condition="'$(MATR_TARGET_RID)' != 'osx-arm64'" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MFAAvalonia\MFAAvalonia.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <RuntimeHostConfigurationOption Include="SubdirectoriesToProbe" Value="runtimes/libs"/>
        <!-- MaaFramework 的 .NET 启动钩子：在 Main 之前加载 MaaFramework 原生库。
             声明为程序集引用以进入 deps.json，并由 RuntimeHostConfigurationOption 写入 runtimeconfig.json
             的 STARTUP_HOOKS，使发布产物不再依赖手工放置 libloader.dll。 -->
        <Reference Include="libloader">
            <HintPath>..\..\libloader.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <RuntimeHostConfigurationOption Include="STARTUP_HOOKS" Value="libloader"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\cliff.toml">
            <Link>cliff.toml</Link>
        </Content>
        <Content Include="..\docs\en\external-notification.md">
            <Link>docs\en\external-notification.md</Link>
        </Content>
        <Content Include="..\docs\images\maa-logo_512x512.png">
            <Link>docs\images\maa-logo_512x512.png</Link>
        </Content>
        <Content Include="..\docs\images\preview.png">
            <Link>docs\images\preview.png</Link>
        </Content>
        <Content Include="..\docs\zh\外部通知.md">
            <Link>docs\zh\外部通知.md</Link>
        </Content>
        <Content Include="..\README_en.md">
            <Link>README_en.md</Link>
        </Content>
        <Content Include="..\README.md">
            <Link>README.md</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\MFAAvalonia\DependencySetup_依赖库安装_win.bat"
                 Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))"
                 CopyToPublishDirectory="PreserveNewest">
            <Link>DependencySetup_依赖库安装_win.bat</Link>
        </Content>

        <Content Include="..\MFAAvalonia\DependencySetup_依赖库安装_linux.sh"
                 Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux'))"
                 CopyToPublishDirectory="PreserveNewest">
            <Link>DependencySetup_依赖库安装_linux.sh</Link>
        </Content>

        <Content Include="..\MFAAvalonia\DependencySetup_依赖库安装_mac.sh"
                 Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx'))"
                 CopyToPublishDirectory="PreserveNewest">
            <Link>DependencySetup_依赖库安装_mac.sh</Link>
        </Content>
    </ItemGroup>

    <Target Name="RemoveUnwantedFiles" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
        <PropertyGroup>
            <!-- 使用发布时实际写入的 PublishDir，避免按 OutputPath 推算（宿主 RID 不附加进输出路径时推算会错位） -->
            <MainPublishDir>$([MSBuild]::NormalizeDirectory('$(PublishDir)'))</MainPublishDir>
        </PropertyGroup>

        <ItemGroup>
            <PdbFilesToDelete Include="$(MainPublishDir)**\*.pdb"/>
            <XmlFilesToDelete Include="$(MainPublishDir)SukiUI.xml"/>
        </ItemGroup>

        <Delete Files="@(PdbFilesToDelete);@(XmlFilesToDelete);@(RuntimeConfigFilesToDelete)" ContinueOnError="true"/>

        <!-- 移除 NuGet 包自带的默认 interface.json（项目使用根目录的自定义版本） -->
        <RemoveDir Directories="$(MainPublishDir)resource\agent;$(MainPublishDir)resource\backup;$(MainPublishDir)resource\config;$(MainPublishDir)resource\temp" ContinueOnError="true"/>
        <Delete Files="$(MainPublishDir)resource\interface.json;$(MainPublishDir)resource\mfa_layout.json;$(MainPublishDir)resource\Changelog.md" ContinueOnError="true"/>
    </Target>
</Project>
