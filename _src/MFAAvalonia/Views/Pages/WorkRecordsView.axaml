<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avaConverters="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:MFAAvalonia.Models"
             xmlns:pages="clr-namespace:MFAAvalonia.ViewModels.Pages"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="720"
             x:DataType="pages:WorkRecordsViewModel"
             x:Class="MFAAvalonia.Views.Pages.WorkRecordsView">
    <Grid Margin="0,0,0,8"
          RowDefinitions="*"
          ColumnDefinitions="360,*"
          ColumnSpacing="18"
          RowSpacing="4">
        <Grid.Styles>
            <Style Selector="TextBlock.RecordCardTitle">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="#26354A" />
            </Style>
            <Style Selector="TextBlock.RecordSectionTitle">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="#7B8798" />
            </Style>
            <Style Selector="TextBlock.RecordBody">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#475467" />
            </Style>
            <Style Selector="TextBlock.RecordResourceBody">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#527A68" />
            </Style>
            <Style Selector="TextBlock.RecordSwordBody">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#586B85" />
            </Style>
        </Grid.Styles>
        <!-- 左侧记录卡片 -->
        <Grid RowDefinitions="*,Auto"
              RowSpacing="0">
            <Border Background="{DynamicResource SukiCardBackground}"
                    BorderBrush="{DynamicResource SukiControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="10,12">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <TextBlock Text="记录列表"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SukiText}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="Basic"
                                Command="{Binding SaveCommand}"
                                Content="保存"
                                Padding="10,4"
                                IsEnabled="{Binding CanSaveSelectedRecords}" />
                        <Button Grid.Column="2"
                                Classes="Basic"
                                Command="{Binding RefreshCommand}"
                                Content="刷新数据"
                                Padding="10,4" />
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="LogRecordsList"
                                 ItemsSource="{Binding Records}"
                                 SelectionMode="Multiple"
                                 SelectionChanged="LogRecordsSelectionChanged"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem Border.SelectionBackground">
                                <Setter Property="Opacity" Value="0" />
                            </Style>
                            <Style Selector="ListBoxItem Border.HoverBackground">
                                <Setter Property="Opacity" Value="0" />
                            </Style>
                            <Style Selector="ListBoxItem Border.SelectionIndicator">
                                <Setter Property="Opacity" Value="0" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover Border.HoverBackground">
                                <Setter Property="Opacity" Value="0.04" />
                            </Style>
                            <Style Selector="ListBoxItem:selected Border.SelectionBackground">
                                <Setter Property="Opacity" Value="0.09" />
                            </Style>
                            <Style Selector="ListBoxItem:selected Border.SelectionIndicator">
                                <Setter Property="Opacity" Value="1" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemContainerTheme>
                            <ControlTheme TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </ControlTemplate>
                                </Setter>
                            </ControlTheme>
                        </ListBox.ItemContainerTheme>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:WorkRecord">
                                <Grid ColumnDefinitions="3,*"
                                      RowDefinitions="Auto,Auto"
                                      ColumnSpacing="10"
                                      Margin="0,1">
                                    <Border Classes="SelectionBackground"
                                            Grid.ColumnSpan="2"
                                            Grid.RowSpan="2"
                                            Background="{DynamicResource SukiPrimaryColor}"
                                            CornerRadius="8" />
                                    <Border Classes="HoverBackground"
                                            Grid.ColumnSpan="2"
                                            Grid.RowSpan="2"
                                            Background="{DynamicResource SukiPrimaryColor}"
                                            CornerRadius="8" />
                                    <Border Classes="SelectionIndicator"
                                            Grid.RowSpan="2"
                                            Background="{DynamicResource SukiPrimaryColor}"
                                            CornerRadius="2" />
                                    <Grid Grid.Column="1"
                                          ColumnDefinitions="*,Auto,Auto"
                                          ColumnSpacing="8">
                                        <TextBlock Text="{Binding TaskName}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#344054"
                                                   Margin="4,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DisplayConfigName}"
                                                   FontSize="11"
                                                   Foreground="#7B8798"
                                                   Margin="0,3,0,0"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding DisplayConfigName, Converter={x:Static avaConverters:StringConverters.IsNotNullOrEmpty}}" />
                                        <Border Grid.Column="2"
                                                Background="{Binding StatusBackground}"
                                                CornerRadius="5"
                                                Padding="7,2"
                                                Margin="0,1,4,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayStatus}"
                                                       FontSize="11"
                                                       Foreground="{Binding StatusForeground}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{Binding ListTimeText}"
                                               FontSize="12"
                                               Foreground="#7B8798"
                                               Margin="4,0,4,3"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    IsVisible="{Binding HasSavedRecords}"
                    Margin="0,10,0,0"
                    MaxHeight="300"
                    Background="{DynamicResource SukiCardBackground}"
                    BorderBrush="{DynamicResource SukiControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="10,12">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="4">
                        <TextBlock Text="已保存记录"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SukiText}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="Basic"
                                Command="{Binding RenameSavedCommand}"
                                Content="重命名"
                                Padding="8,4"
                                IsEnabled="{Binding CanRenameSavedRecord}" />
                        <Button Grid.Column="2"
                                Classes="Basic"
                                Command="{Binding MergeSavedCommand}"
                                Content="合并"
                                Padding="8,4"
                                IsEnabled="{Binding CanMergeSavedRecords}" />
                        <Button Grid.Column="3"
                                Classes="Basic"
                                Command="{Binding DeleteSavedCommand}"
                                Content="删除"
                                Padding="8,4"
                                IsEnabled="{Binding CanDeleteSavedRecords}" />
                        <Button Grid.Column="4"
                                Classes="Basic"
                                Command="{Binding ClearSavedCommand}"
                                Content="清空"
                                Padding="8,4" />
                    </Grid>
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="SavedRecordsList"
                                 ItemsSource="{Binding SavedRecords}"
                                 SelectionMode="Multiple"
                                 SelectionChanged="SavedRecordsSelectionChanged"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:SavedWorkRecord">
                                    <Border Background="#F3F6FB"
                                            CornerRadius="8"
                                            Padding="8,5"
                                            Margin="0,2">
                                        <Grid RowDefinitions="Auto"
                                              ColumnDefinitions="*,Auto"
                                              ColumnSpacing="8">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#344054"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DurationText}"
                                                       FontSize="11"
                                                       Foreground="#7B8798" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 右侧详情卡片 -->
        <ScrollViewer Grid.Column="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <Border IsVisible="{Binding HasSelectionSummary}"
                        Background="{DynamicResource SukiCardBackground}"
                        BorderBrush="{DynamicResource SukiControlBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,16">
                    <TextBlock Text="{Binding SelectionSummary}"
                               Classes="RecordBody"
                               FontSize="16" />
                </Border>
                <!-- 任务概况 -->
                <Border Background="{DynamicResource SukiCardBackground}"
                        BorderBrush="{DynamicResource SukiControlBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        IsVisible="{Binding SelectedRecord, Converter={x:Static avaConverters:ObjectConverters.IsNotNull}}"
                        Padding="18,16">
                    <StackPanel Spacing="16">
                        <TextBlock Classes="RecordCardTitle" Text="任务概况" />
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="12">
                            <TextBlock Text="{Binding SelectedRecord.TaskName}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#344054"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedConfigSourceText}"
                                       FontSize="12"
                                       Foreground="#7B8798"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding SelectedConfigSourceText, Converter={x:Static avaConverters:StringConverters.IsNotNullOrEmpty}}" />
                            <Border Grid.Column="2"
                                    Background="{Binding SelectedRecord.StatusBackground}"
                                    CornerRadius="5"
                                    Padding="8,3">
                                <Border.IsVisible>
                                    <Binding Path="ShowSelectedStatus" />
                                </Border.IsVisible>
                                <TextBlock Text="{Binding SelectedRecord.DisplayStatus}"
                                           FontSize="12"
                                           Foreground="{Binding SelectedRecord.StatusForeground}" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding SelectedTimeText}"
                                   FontSize="14"
                                   Foreground="#7B8798" />
                        <StackPanel Orientation="Horizontal"
                                    Spacing="24"
                                    Margin="0,3,0,0">
                            <TextBlock Text="{Binding SelectedRecord.SortieCount, StringFormat=出阵次数：{0}}"
                                       FontSize="14"
                                       Foreground="#344054" />
                            <TextBlock
                                       Text="{Binding SelectedRecord.MarchCount, StringFormat=行军次数：{0}}"
                                       FontSize="14"
                                       Foreground="#344054" />
                            <TextBlock
                                       Text="{Binding SelectedRecord.RoundCount, StringFormat=完成圈数：{0}}"
                                       FontSize="14"
                                       Foreground="#344054" />
                            <TextBlock
                                       Text="{Binding SelectedRecord.FlowerBrushCount, StringFormat=刷花次数：{0}}"
                                       FontSize="14"
                                       Foreground="#344054"
                                       IsVisible="{Binding SelectedHasFlowerBrush}" />
                            <TextBlock
                                       Text="{Binding SelectedRecord.ReturnHomeCount, StringFormat=返回本丸：{0}}"
                                       FontSize="14"
                                       Foreground="#344054"
                                       IsVisible="{Binding SelectedHasReturnHome}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 出阵收获：资源与刀剑掉落 -->
                <Border Background="{DynamicResource SukiCardBackground}"
                        BorderBrush="{DynamicResource SukiControlBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,16"
                        IsVisible="{Binding SelectedHasOutcomes}">
                    <StackPanel Spacing="9">
                        <TextBlock Classes="RecordCardTitle" Text="出阵收获" />
                        <StackPanel Spacing="6"
                                    IsVisible="{Binding SelectedHasResources}">
                            <TextBlock Classes="RecordSectionTitle" Text="资源收获" />
                            <TextBlock Classes="RecordResourceBody"
                                       Text="{Binding SelectedResourcesText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="6"
                                    IsVisible="{Binding SelectedHasSwordDrops}"
                                    Margin="0,8,0,0">
                            <TextBlock Classes="RecordSectionTitle" Text="刀剑掉落" />
                            <ItemsControl ItemsSource="{Binding SelectedSwordDropGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="pages:SwordDropGroupDisplay">
                                        <TextBlock Classes="RecordSwordBody"
                                                   LineHeight="24"
                                                   TextWrapping="Wrap">
                                            <Run Text="{Binding SwordType}"
                                                 FontWeight="Bold" />
                                            <Run Text="：" />
                                            <Run Text="{Binding DropsText}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 后勤记录 -->
                <Border Background="{DynamicResource SukiCardBackground}"
                        BorderBrush="{DynamicResource SukiControlBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,16"
                        IsVisible="{Binding SelectedHasLogistics}">
                    <StackPanel Spacing="9">
                        <TextBlock Classes="RecordCardTitle" Text="后勤记录" />
                        <TextBlock Classes="RecordBody"
                                   Text="{Binding SelectedLogisticsSummaryText}"
                                   IsVisible="{Binding SelectedHasLogisticsSummary}"
                                   TextWrapping="Wrap" />
                        <StackPanel Spacing="4"
                                    IsVisible="{Binding SelectedHasLogisticsDispatch}"
                                    Margin="0,8,0,0">
                            <TextBlock Classes="RecordBody"
                                       Text="{Binding SelectedLogisticsDispatchCountText}"
                                       IsVisible="{Binding SelectedHasLogisticsDispatch}" />
                            <ItemsControl ItemsSource="{Binding SelectedLogisticsDispatchTexts}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"
                                                   ItemSpacing="18"
                                                   LineSpacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Classes="RecordBody"
                                                   Text="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 特殊情况 -->
                <Border Background="{DynamicResource SukiCardBackground}"
                        BorderBrush="{DynamicResource SukiControlBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,16"
                        IsVisible="{Binding SelectedHasSpecialEvents}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="RecordCardTitle" Text="特殊情况" />
                        <TextBlock Classes="RecordBody"
                                   Text="{Binding SelectedSpecialEventsText}"
                                   LineHeight="23"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
